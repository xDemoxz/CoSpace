# Copia este archivo a .env y completa los valores. Nunca subas el .env real.

# Conexión a PostgreSQL. En Supabase: botón "Connect" > "Session pooler" (puerto 5432).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos (sin corchetes).
DATABASE_URL=

# Secretos de los JWT: distintos entre sí y de 32+ caracteres.
# Genera cada uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duración de los tokens: número + unidad (s, m, h, d).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Administrador que crea el seed.
SEED_ADMIN_EMAIL=admin@cospace.com
SEED_ADMIN_PASSWORD=Admin1234!
