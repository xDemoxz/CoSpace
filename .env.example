# Copy this file to `.env.local` (or `.env`) and fill in your values.
# See https://nextjs.org/docs/app/building-your-application/configuring/environment-variables for details.

# Public API URL (accessible in browser and server via process.env.NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_API_URL=https://api.example.com

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_ACCESS_SECRET="pega aquí un valor aleatorio de 32+ caracteres"
JWT_REFRESH_SECRET="otro valor distinto de 32+ caracteres"
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SEED_ADMIN_EMAIL=admin@cospace.com
SEED_ADMIN_PASSWORD=Admin1234!
